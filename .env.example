APP_ENV=development
APP_URL=http://localhost:8080

# Database: mysql | sqlite
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL (dipakai jika DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=digital_store
DB_USERNAME=root
DB_PASSWORD=

# Payment Gateway (QRIS)
PAYMENT_PROVIDER=dummy
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_CALLBACK_URL=http://localhost:8080/api/payment-webhook.php

# Mail
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tokodigital.test
MAIL_FROM_NAME="Toko Digital"

# Security
APP_KEY=change-this-to-random-32-bytes
